# Keep the Cloud Build source upload small and exclude local credentials.
#!include:.gitignore

.git
.gcloudignore
.venv
.venv*/
.env
.env.*
wallet/
wallets/
*.pem
*.key
*.sso
*.p12
*.zip
__pycache__/
.pytest_cache/
.ruff_cache/
build/
dist/
doc/
docs/
tests/
samples/
*.docx
*.pdf
*.png
*.jpg
*.jpeg
build/
